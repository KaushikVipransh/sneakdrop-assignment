# Pooled connection used by the app (Neon: the "-pooler" host).
DATABASE_URL=postgres://sneakdrop:sneakdrop@localhost:5432/sneakdrop
# Direct connection used by migrations (Neon: the non-pooler host).
DATABASE_URL_DIRECT=postgres://sneakdrop:sneakdrop@localhost:5432/sneakdrop
# Database used by the test suite.
DATABASE_URL_TEST=postgres://sneakdrop:sneakdrop@localhost:5432/sneakdrop_test
# Shared secret for signing fake-provider webhooks (openssl rand -hex 32).
WEBHOOK_SECRET=dev-webhook-secret-change-me-0123456789
# Public base URL; the fake provider sends webhooks to APP_URL/api/webhooks/payments.
APP_URL=http://localhost:3000
